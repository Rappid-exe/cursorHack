{
  "name": "blast-radius",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "scan": "node --env-file=.env.local --import tsx scripts/blast-radius.ts examples/mcp.json --tools examples/tools.json",
    "scan:mine": "node --env-file=.env.local --import tsx scripts/blast-radius.ts",
    "scan:discover": "node --env-file=.env.local --import tsx scripts/blast-radius.ts examples/mcp.json --discover",
    "verify": "tsx scripts/verify-engine.ts && tsx scripts/verify-drift.ts && tsx scripts/verify-observe.ts && tsx scripts/verify-fallback.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/cross-spawn": "^6.0.6",
    "cross-spawn": "^7.0.6",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
